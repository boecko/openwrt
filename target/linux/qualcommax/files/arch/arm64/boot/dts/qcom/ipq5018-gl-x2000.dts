/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "GL.iNet GL-X2000";
	compatible = "glinet,gl-x2000", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		serial1 = &blsp1_uart2;
		ethernet0 = &dp1;
		ethernet1 = &dp2;
		label-mac-device = &dp2;
		led-boot = &led_system_power;
		led-failsafe = &led_status_internet;
		led-running = &led_status_internet;
		led-upgrade = &led_system_power;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_2 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};
    
	fan: pwm-fan {
		compatible = "pwm-fan";
		pinctrl-0 = <&fan_pins>;
		pinctrl-names = "default";
		fan-supply = <&regulator_fixed_5p0>;
		interrupt-parent = <&tlmm>;
		interrupts = <31 IRQ_TYPE_EDGE_RISING>;
		cooling-levels = <36 128 192 255>;
		#cooling-cells = <2>;
		pwms = <&pwm 3 40000 0>;
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_power: led_system_power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_status_internet: led_status_internet {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wifi_2g {
			function = LED_FUNCTION_WLAN_2GHZ;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <2>;
			gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wifi_5g {
			function = LED_FUNCTION_WLAN_5GHZ;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <5>;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_5g_signal1 {
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <1>;
			gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_5g_signal2 {
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <2>;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_5g_signal3 {
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <3>;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_5g_signal4 {
			function = LED_FUNCTION_INDICATOR;
			color = <LED_COLOR_ID_GREEN>;
			function-enumerator = <4>;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button_reset {
			label = "reset";
			gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	regulator_fixed_5p0: regulator-s0500 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <500000>;
		regulator-max-microvolt = <500000>;
		regulator-name = "regulator_fixed_5p0";
		gpio = <&tlmm 34 GPIO_ACTIVE_LOW>;
		enable-active-high;
		regulator-boot-on;
	};

	usb_vreg_5p0: usb-vreg-5p0 {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vbus_reg";
		gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
	};
};

/*
* =================================================================
*     _______________________             ____________
*    |        IPQ5018        |           |            |
*    | +------+   +--------+ |           | +--------+ |
*    | | MAC0 |---| GE Phy |-+--- MDI ---+ | RJ45   | +
*    | +------+   +--------+ |           | +--------+ |
*    |                       |           |____________|
*    |                       |            _______________________
*    |                       |           |       Unknown Phy     |
*    | +------+   +--------+ |           | +--------+   +------+ |
*    | | MAC1 |---| Uniphy |-+-- SGMII---+ | Phy    |---| RJ45 | |
*    | +------+   +--------+ |           | +--------+   +------+ |
*    |_______________________|           |_______________________|
*
* =================================================================
 */

&switch {
	status = "okay";

	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		// MAC0 -> GE Phy -> MDI --> RJ45
		port@1 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		// MAC1 ---SGMII---> Unknown PHY -> RJ45
		port@2 {
			port_id = <2>;
			mdiobus = <&mdio1>;
			phy_address = <4>;
		};
	};
};

// MAC0 ---MDI---> IPQ5018 GE PHY
&dp1 {
	status = "okay";

	label = "wan";
	phy-handle = <&ge_phy>;
	nvmem-cells = <&macaddr_dp2>;
	nvmem-cell-names = "mac-address";
};

// MAC1 ---SGMII---> Ethernet Phy
&dp2 {
	status = "okay";

	label = "lan";
	phy-handle = <&ethernet_phy>;
	nvmem-cells = <&macaddr_dp2 1>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	// Ethernet PHY
	ethernet_phy: ethernet-phy@4 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <4>;
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
 	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_dp2: macaddr@0 {
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
						reg = <0x6 0x6>;
					};
				};
			};
		};
	};
};

&tlmm {
	blsp0_spi_pins: blsp0_spi_pins {
		pins = "gpio10", "gpio11";
		function = "blsp0_spi";
		drive-strength = <2>;
		bias-disable;
	};

	button_pins: button_pins {
		button_reset {
			pins = "gpio27";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	cellular_pins: cellular_pins {
		cellular_en {
			pins = "gpio12";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};

		cellular_reset {
			pins = "gpio22";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};

		cellular_power {
			pins = "gpio38";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
			output-low;
		};
	};

	fan_pins: fan_pins {
		pwr {
			pins = "gpio34";
			function = "gpio";
			output-high;
		};

		speed {
			pins = "gpio26";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
		};
	};
	
	leds_pins: leds_pins {
		led_system_power {
			pins = "gpio28";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_status_internet {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		wlan2g {
			pins = "gpio1";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		wlan5g {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		lte1 {
			pins = "gpio44";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		lte2 {
			pins = "gpio24";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		lte3 {
			pins = "gpio17";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		lte4 {
			pins = "gpio19";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pwm_pins: pwm_pinmux {
		mux {
			pins = "gpio13";
			function = "gpio";
			drive-strength = <8>;
		};
	};
	
	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};

	usbhub_pins: usbhub_pins {
		hub_reset {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-disable;
			output-high;
		};
	};
};

&usb {
	status = "okay";

	vbus-supply = <&usb_vreg_5p0>;
	qcom,select-utmi-as-pipe-clk;
};

&usb_dwc {
	dr_mode = "host";
};

&usbphy0 {
	status = "okay";

	vdd-supply = <&usb_vreg_5p0>;
};

&pwm {
    pinctrl-0 = <&pwm_pins>;
    pinctrl-names = "default";
    status = "okay";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "GL-iNet-GL-X2000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";
	
	qcom,rproc = <&q6_wcss_pd3>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
	qcom,ath11k-calibration-variant = "GL-iNet-GL-X2000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
